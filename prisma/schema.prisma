// 닥터플래너스 CMS — Railway Postgres (DATABASE_URL)
// 스키마를 바꾸면: npx prisma migrate dev --name <이름>  (로컬 DB 필요)
// 배포 때는 scripts/start.sh 가 prisma migrate deploy 로 적용합니다.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 인사이트 글 — 칼럼 · 블로그 · 공지사항
enum PostBoard {
  COLUMN
  BLOG
  NOTICE
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Post {
  id           Int        @id @default(autoincrement())
  board        PostBoard
  title        String
  slug         String     @unique
  /// 본문 HTML (Tiptap) — 저장 전에 허용 태그만 남깁니다
  content      String
  excerpt      String?
  thumbnailUrl String?
  status       PostStatus @default(DRAFT)
  /// 처음 발행한 시각 — 임시저장으로 돌렸다 다시 발행해도 유지됩니다
  publishedAt  DateTime?
  viewCount    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([board, status, publishedAt])
}

/// 관리자에서 올린 이미지 — 별도 스토리지 없이 DB에 보관하고 /media/[id] 로 내보냅니다
model Media {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

enum InquiryKind {
  CONTACT
  DIAGNOSIS
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  DONE
}

/// 문의 · 무료 진단 접수 — 메일 발송과 별개로 항상 저장됩니다
model Inquiry {
  id         Int           @id @default(autoincrement())
  kind       InquiryKind
  status     InquiryStatus @default(NEW)
  clinic     String
  department String
  name       String
  position   String?
  phone      String
  email      String
  interests  String[]
  message    String?
  /// 진단 문항 응답 — [{ q, a }]
  answers    Json?
  /// 메일 발송 결과 — 실패했다면 관리자 화면에서 바로 보이게
  mailed     Boolean       @default(false)
  /// 접수한 방문 — 어느 채널로 들어와 무엇을 보고 신청했는지
  visitId    String?
  memo       String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([visitId])
}

/// 자체 방문 통계 — 한 번의 방문(30분 동안 다음 페이지가 없으면 끝). 이름 · 주소 · 쿠키 없음
model Visit {
  id        String   @id
  /// 브라우저가 만든 임의 번호 — 재방문 구분용
  visitor   String
  startedAt DateTime @default(now())
  lastAt    DateTime @default(now())
  pages     Int      @default(1)
  /// 처음 들어온 페이지
  landing   String
  /// 어디서 왔는지 — 주소의 호스트, 전체 주소
  referrer  String?
  refUrl    String?
  /// 분류 — 검색 · 광고 · SNS … / 네이버 검색 · 인스타그램 …
  grp       String
  channel   String
  source    String?
  medium    String?
  campaign  String?
  keyword   String?
  device    String
  os        String?
  browser   String?
  isNew     Boolean  @default(true)
  hits      Hit[]

  @@index([startedAt])
  @@index([visitor])
}

/// 방문 안의 행동 — 페이지 보기(pv) · 전화(tel) · 카카오(kakao) · 지도(map) · 바깥 링크(out) · 폼 제출(form)
model Hit {
  id      Int      @id @default(autoincrement())
  visitId String
  visit   Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  kind    String
  path    String
  target  String?
  at      DateTime @default(now())

  @@index([visitId])
  @@index([at, kind])
}

/// 관리자 설정 — 통계에서 뺄 IP 등
model Setting {
  key   String @id
  value String
}
